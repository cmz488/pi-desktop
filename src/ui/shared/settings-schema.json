[
  {
    "id": "agent",
    "title": "模型与思考",
    "fields": [
      {
        "key": "defaultProvider",
        "label": "默认提供商",
        "type": "string",
        "default": ""
      },
      {
        "key": "defaultModel",
        "label": "默认模型 ID",
        "type": "string",
        "default": ""
      },
      {
        "key": "defaultThinkingLevel",
        "label": "思考强度",
        "type": "enum",
        "default": "medium",
        "options": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
      },
      {
        "key": "enabledModels",
        "label": "模型选择范围",
        "type": "array",
        "default": [],
        "help": "每行一个 provider/model 模式；留空使用全部可用模型。"
      },
      {
        "key": "modelThinkingLevels",
        "label": "各模型思考强度",
        "type": "object",
        "default": {}
      },
      {
        "key": "thinkingBudgets",
        "label": "思考 Token 预算",
        "type": "object",
        "default": {}
      },
      {
        "key": "hideThinkingBlock",
        "label": "隐藏思考内容",
        "type": "boolean",
        "default": false
      },
      {
        "key": "showCacheMissNotices",
        "label": "显示缓存通知",
        "type": "boolean",
        "default": false
      },
      {
        "key": "cacheWarming",
        "label": "缓存预热",
        "type": "enum",
        "default": "streaming",
        "options": ["off", "streaming", "idle"],
        "globalOnly": true
      }
    ]
  },
  {
    "id": "interaction",
    "title": "会话与工具",
    "fields": [
      {
        "key": "steeringMode",
        "label": "引导消息处理",
        "type": "enum",
        "default": "one-at-a-time",
        "options": ["one-at-a-time", "all"]
      },
      {
        "key": "followUpMode",
        "label": "后续消息处理",
        "type": "enum",
        "default": "one-at-a-time",
        "options": ["one-at-a-time", "all"]
      },
      {
        "key": "defaultTools",
        "label": "默认工具",
        "type": "array",
        "default": ["read", "bash", "edit", "write"],
        "help": "每行一个名称；支持 +工具、-工具。"
      },
      {
        "key": "codemode.mode",
        "label": "Codemode 工具模式",
        "type": "enum",
        "default": "on",
        "options": ["on", "only"]
      },
      {
        "key": "codemode.inlineBudget",
        "label": "Codemode 声明预算",
        "type": "number",
        "default": 3000
      },
      {
        "key": "sessionDir",
        "label": "会话存储目录",
        "type": "string",
        "default": ""
      },
      {
        "key": "defaultProjectTrust",
        "label": "项目默认信任",
        "type": "enum",
        "default": "ask",
        "options": ["ask", "always", "never"],
        "globalOnly": true
      },
      {
        "key": "doubleEscapeAction",
        "label": "双击 Esc 动作",
        "type": "enum",
        "default": "tree",
        "options": ["tree", "fork", "none"]
      },
      {
        "key": "treeFilterMode",
        "label": "会话树过滤",
        "type": "enum",
        "default": "default",
        "options": ["default", "no-tools", "user-only", "labeled-only", "all"]
      }
    ]
  },
  {
    "id": "context",
    "title": "上下文与压缩",
    "fields": [
      {
        "key": "compaction.enabled",
        "label": "自动压缩上下文",
        "type": "boolean",
        "default": true,
        "help": "上下文接近模型上限时，由 pi 自动总结较早的消息。也可在对话输入 /compact 手动压缩。"
      },
      {
        "key": "compaction.reserveTokens",
        "label": "压缩触发预留 Token",
        "type": "number",
        "default": 16384,
        "help": "当模型上下文剩余空间低于此值时触发自动压缩。"
      },
      {
        "key": "compaction.keepRecentTokens",
        "label": "保留近期 Token",
        "type": "number",
        "default": 20000,
        "help": "压缩时保留近期消息，其余历史由摘要替代。"
      },
      {
        "key": "compaction.modelOverrides",
        "label": "各模型压缩设置",
        "type": "object",
        "default": {},
        "help": "按 provider/model 设置不同压缩阈值。使用原生 pi JSON 格式。"
      },
      {
        "key": "branchSummary.reserveTokens",
        "label": "分支摘要预留 Token",
        "type": "number",
        "default": 16384
      },
      {
        "key": "branchSummary.skipPrompt",
        "label": "跳过分支摘要询问",
        "type": "boolean",
        "default": false
      }
    ]
  },
  {
    "id": "network",
    "title": "网络与重试",
    "fields": [
      {
        "key": "transport",
        "label": "模型传输方式",
        "type": "enum",
        "default": "auto",
        "options": ["auto", "sse", "websocket", "websocket-cached"]
      },
      {
        "key": "httpProxy",
        "label": "HTTP 代理",
        "type": "string",
        "default": "",
        "globalOnly": true,
        "secret": true,
        "help": "留空保留已有值；重启服务后应用。"
      },
      {
        "key": "httpIdleTimeoutMs",
        "label": "HTTP 空闲超时（毫秒）",
        "type": "number",
        "default": 300000
      },
      {
        "key": "websocketConnectTimeoutMs",
        "label": "WebSocket 连接超时（毫秒）",
        "type": "number",
        "default": 15000
      },
      {
        "key": "retry.enabled",
        "label": "自动重试",
        "type": "boolean",
        "default": true
      },
      {
        "key": "retry.maxRetries",
        "label": "最大重试次数",
        "type": "number",
        "default": 3
      },
      {
        "key": "retry.baseDelayMs",
        "label": "重试初始间隔（毫秒）",
        "type": "number",
        "default": 2000
      },
      {
        "key": "retry.maxAgentDelayMs",
        "label": "重试最长等待（毫秒）",
        "type": "number",
        "default": 60000
      },
      {
        "key": "retry.provider.timeoutMs",
        "label": "提供商请求超时（毫秒）",
        "type": "number",
        "default": 300000
      },
      {
        "key": "retry.provider.maxRetries",
        "label": "提供商重试次数",
        "type": "number",
        "default": 0
      },
      {
        "key": "retry.provider.maxRetryDelayMs",
        "label": "提供商最长重试等待（毫秒）",
        "type": "number",
        "default": 60000
      }
    ]
  },
  {
    "id": "resources",
    "title": "资源与 Shell",
    "fields": [
      {
        "key": "extensions",
        "label": "扩展路径 / 过滤",
        "type": "array",
        "default": [],
        "help": "每行一个路径或过滤规则；支持 +path、-path、!pattern。"
      },
      {
        "key": "skills",
        "label": "技能路径 / 过滤",
        "type": "array",
        "default": [],
        "help": "每行一个路径或过滤规则；支持 +path、-path、!pattern。"
      },
      {
        "key": "prompts",
        "label": "提示模板路径 / 过滤",
        "type": "array",
        "default": [],
        "help": "每行一个路径或过滤规则；支持 +path、-path、!pattern。"
      },
      {
        "key": "themes",
        "label": "主题路径 / 过滤",
        "type": "array",
        "default": [],
        "help": "每行一个路径或过滤规则；支持 +path、-path、!pattern。"
      },
      {
        "key": "enableSkillCommands",
        "label": "注册 /skill 命令",
        "type": "boolean",
        "default": true
      },
      {
        "key": "shellPath",
        "label": "Shell 可执行路径",
        "type": "string",
        "default": ""
      },
      {
        "key": "shellCommandPrefix",
        "label": "Shell 命令前缀",
        "type": "string",
        "default": ""
      },
      {
        "key": "externalEditor",
        "label": "外部编辑器命令",
        "type": "string",
        "default": ""
      },
      {
        "key": "npmCommand",
        "label": "npm 命令与参数",
        "type": "array",
        "default": ["npm"]
      }
    ]
  },
  {
    "id": "display",
    "title": "终端与显示",
    "fields": [
      {
        "key": "theme",
        "label": "Pi 终端主题",
        "type": "string",
        "default": "system"
      },
      {
        "key": "quietStartup",
        "label": "隐藏启动标题",
        "type": "boolean",
        "default": false
      },
      {
        "key": "tuiMode",
        "label": "终端显示模式",
        "type": "enum",
        "default": "regular",
        "options": ["regular", "fullscreen"]
      },
      {
        "key": "fullscreenExitOutput",
        "label": "退出全屏输出",
        "type": "enum",
        "default": "transcript",
        "options": ["transcript", "resume-hint"]
      },
      {
        "key": "fullscreenScrollbar",
        "label": "全屏滚动条",
        "type": "enum",
        "default": "auto",
        "options": ["auto", "always", "hidden"]
      },
      {
        "key": "fullscreenCopyOnSelect",
        "label": "选中自动复制",
        "type": "boolean",
        "default": true
      },
      {
        "key": "fullscreenWheelScrollLines",
        "label": "滚轮行数",
        "type": "auto-number",
        "default": "auto",
        "min": 1,
        "max": 100
      },
      {
        "key": "editorPaddingX",
        "label": "编辑区横向留白",
        "type": "number",
        "default": 0,
        "max": 3
      },
      {
        "key": "outputPad",
        "label": "输出横向留白",
        "type": "number",
        "default": 1,
        "max": 1
      },
      {
        "key": "autocompleteMaxVisible",
        "label": "补全可见条目",
        "type": "number",
        "default": 5,
        "min": 3,
        "max": 20
      },
      {
        "key": "showHardwareCursor",
        "label": "显示硬件光标",
        "type": "boolean",
        "default": false
      },
      {
        "key": "terminal.showImages",
        "label": "终端显示图片",
        "type": "boolean",
        "default": true
      },
      {
        "key": "terminal.imageWidthCells",
        "label": "终端图片宽度",
        "type": "number",
        "default": 60
      },
      {
        "key": "terminal.clearOnShrink",
        "label": "内容收缩时清空行",
        "type": "boolean",
        "default": false
      },
      {
        "key": "terminal.showTerminalProgress",
        "label": "终端标签进度",
        "type": "boolean",
        "default": false
      },
      {
        "key": "terminal.hyperlinks",
        "label": "终端超链接",
        "type": "enum",
        "default": "auto",
        "options": ["auto", true, false]
      },
      {
        "key": "terminal.trueColor",
        "label": "终端真彩色",
        "type": "enum",
        "default": "auto",
        "options": ["auto", true, false]
      },
      {
        "key": "terminal.images",
        "label": "终端图片协议",
        "type": "enum",
        "default": "auto",
        "options": ["auto", "kitty", "iterm2", false]
      },
      {
        "key": "images.autoResize",
        "label": "自动缩放发送图片",
        "type": "boolean",
        "default": true
      },
      {
        "key": "images.blockImages",
        "label": "禁止发送图片",
        "type": "boolean",
        "default": false
      },
      {
        "key": "markdown.codeBlockIndent",
        "label": "代码块缩进",
        "type": "string",
        "default": "  "
      },
      {
        "key": "markdown.mermaid",
        "label": "Mermaid 显示",
        "type": "enum",
        "default": "streaming",
        "options": ["off", "final", "streaming"]
      },
      {
        "key": "collapseChangelog",
        "label": "折叠更新日志",
        "type": "boolean",
        "default": false
      },
      {
        "key": "enableInstallTelemetry",
        "label": "安装匿名统计",
        "type": "boolean",
        "default": true
      },
      {
        "key": "enableAnalytics",
        "label": "分析数据共享",
        "type": "boolean",
        "default": false
      },
      {
        "key": "warnings.anthropicExtraUsage",
        "label": "Anthropic 额外计费提醒",
        "type": "boolean",
        "default": true
      }
    ]
  }
]
