{
  "name": "pi-desktop-extension",
  "version": "0.26.10",
  "description": "Pi Desktop: multi-project Electron and web workspace for Pi Durable agents",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-desktop",
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "index.ts",
    "launch-desktop.mjs",
    "pi-command.mjs",
    "desk.mjs",
    "src/**",
    "assets/**",
    "docs/**",
    "examples/**",
    "licenses/**",
    "scripts/configure-tailscale-proxy.sh",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CONTEXT.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "SOURCES.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=24.21"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "~1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "24.10.1",
    "jsqr": "^1.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "start": "node launch-desktop.mjs",
    "dev": "node desk.mjs",
    "desktop": "node launch-desktop.mjs",
    "prepack": "npm run check",
    "package:check": "node scripts/check-npm-package.mjs",
    "test:package": "npm run package:check",
    "check": "npm run typecheck && node scripts/check-source.mjs",
    "test": "node --test test/*.test.mjs",
    "test:pi": "npm run test:commands && node test/pi-smoke.mjs && npm run test:tui && npm run test:ask && npm run test:context",
    "test:git": "node --test test/git*.test.mjs",
    "test:packages": "node --test test/package-catalog.test.mjs test/package-api.test.mjs test/native-packages.test.mjs",
    "test:lsp": "node --test test/lsp.test.mjs",
    "test:context": "node --test test/context-attachments.test.mjs && node test/context-tui-check.mjs",
    "test:context:browser": "node test/context-files-browser-check.mjs",
    "test:ask": "node test/ask-user-check.mjs",
    "test:commands": "node test/command-discovery-check.mjs && node test/command-discovery-check.mjs --with-extension && node test/command-discovery-check.mjs --installed-package",
    "test:sessions": "node --test test/session-manager.test.mjs test/sessions-command.test.mjs && node test/concurrent-tui-check.mjs",
    "test:tui": "node test/tui-smoke.mjs && node test/concurrent-tui-check.mjs",
    "test:desktop": "PI_WEB_REAL_DESKTOP=1 node test/tui-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "web": "node desk.mjs",
    "install:launcher": "node src/cli/install-launcher.mjs",
    "uninstall:launcher": "node src/cli/install-launcher.mjs --remove",
    "test:web": "node --test test/web.test.mjs",
    "test:browser": "node test/browser-check.mjs",
    "test:extensions:browser": "node test/extension-workbench-browser-check.mjs",
    "format": "prettier --write \"*.{mjs,ts,md,json}\" \"src/**/*.{mjs,js,cjs,ts,html,css,json}\" \"docs/**/*.md\" \"test/*.mjs\" \"examples/*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"*.{mjs,ts,md,json}\" \"src/**/*.{mjs,js,cjs,ts,html,css,json}\" \"docs/**/*.md\" \"test/*.mjs\" \"examples/*.mjs\" \"scripts/*.mjs\"",
    "web:legacy": "node src/server/web.mjs --legacy",
    "test:durable": "node --test --test-isolation=none test/agent-workspace.test.mjs test/durable-models.test.mjs test/durable-server.test.mjs test/durable-features.test.mjs test/durable-network.test.mjs",
    "test:durable:browser": "node test/durable-browser-check.mjs",
    "test:durable:desktop": "node test/durable-desktop-check.mjs",
    "test:durable:recovery": "node test/durable-recovery-check.mjs",
    "test:remote": "node --test test/remote-access.test.mjs test/remote.test.mjs",
    "test:remote:browser": "node test/remote-browser-check.mjs",
    "preview": "node src/cli/preview.mjs",
    "test:workspace": "node --test --test-isolation=none test/desktop-control-plane.test.mjs test/desktop-process-recovery.test.mjs test/projectless-desktop.test.mjs test/desktop-pi-sessions.test.mjs",
    "test:workspace:browser": "node test/desktop-workspace-check.mjs",
    "test:workspace:desktop": "node test/desktop-workspace-check.mjs --electron",
    "web:durable": "node desk.mjs --single-process",
    "desktop:durable": "node launch-desktop.mjs --single-process",
    "test:remote:desktop": "node test/desktop-remote-browser-check.mjs"
  },
  "allowScripts": {
    "electron@41.10.7": true
  },
  "bin": {
    "pi-desktop": "./launch-desktop.mjs",
    "pi-web": "./pi-command.mjs",
    "pi-desk": "./launch-desktop.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "~1.0.2",
    "electron": "41.10.7",
    "@earendil-works/pi-durable": "~1.0.2",
    "agent-browser": "0.38.1",
    "dompurify": "3.4.16",
    "https-proxy-agent": "9.1.0",
    "katex": "0.18.10",
    "marked": "18.0.14",
    "pi-agent-browser-native": "0.9.5",
    "proper-lockfile": "^4.1.2",
    "proxy-from-env": "1.1.0",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
